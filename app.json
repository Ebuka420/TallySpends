{
  "expo": {
    "name": "TallySpends",
    "slug": "TallySpends",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "tallyspends",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Allow TallySpends to use your camera for QR scanning and bank verification through Mono."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.RECEIVE_SMS"
      ],
      "package": "com.ballerdict.TallySpends"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-mark.png",
          "imageWidth": 88,
          "resizeMode": "contain",
          "backgroundColor": "#F5F0F8",
          "dark": {
            "image": "./assets/images/splash-mark-dark.png",
            "backgroundColor": "#111014"
          }
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow TallySpends to use your camera for QR scanning and bank verification through Mono."
        }
      ],
      "expo-font",
      "expo-secure-store",
      ["expo-local-authentication", { "faceIDPermission": "Allow TallySpends to use Face ID to unlock the app and confirm transfers." }],
      "expo-web-browser",
      "expo-sharing",
      "./plugins/withTallySmsReader"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "359be9f0-9224-4d7c-9e32-e81c0010b625"
      }
    }
  }
}
